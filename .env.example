# Copy to .env — never commit .env
APP_ENV=development
DATABASE_URL=postgresql+psycopg2://creator:creator@localhost:5432/creatorlab
# SQLite fallback for local proto only:
# DATABASE_URL=sqlite:///./creatorlab.db
BACKEND_PORT=8000
FRONTEND_PORT=5173
# AI providers (fill as needed, keep empty for Sprint 0.1)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# YouTube (future sprints)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/oauth/callback
