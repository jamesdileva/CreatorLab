# Copy to .env — never commit .env
APP_ENV=development
DATABASE_URL=postgresql+psycopg2://creator:creator@localhost:5432/creatorlab
# SQLite fallback for local proto only:
# DATABASE_URL=sqlite:///./creatorlab.db
BACKEND_PORT=8000
FRONTEND_PORT=5173
# AI providers (stub = deterministic offline; switch without redesign)
LLM_PROVIDER=stub
CREATOR_PROMPT_VERSION=creator_prompt_v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# YouTube Data API (official API first; emulators future-only)
# Redirect URI must be registered in the Google Cloud console:
# http://localhost:8000/api/youtube/oauth/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/oauth/callback
